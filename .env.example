# Variables de entorno del servicio MCP en EasyPanel.
# COPIAR estos valores al panel de EasyPanel (Settings → Environment) — NO commitear este archivo con secretos.

# URL del N8N que va a controlar
N8N_BASE=https://n8n.yoanyandres.one

# API key de N8N (la misma que está en SISTEMA_ACTIVO/.env)
N8N_API_KEY=PEGAR_AQUI_LA_API_KEY_DE_N8N

# Token Bearer que Claude debe enviar para autenticarse
# Generar uno random fuerte (ej. 64 caracteres). Si está vacío, el servidor acepta cualquier llamada (NO usar en prod)
MCP_BEARER_TOKEN=GENERAR_TOKEN_RANDOM_64_CARACTERES

# Puerto interno (por defecto 8080, EasyPanel lo mapea al subdominio)
PORT=8080
